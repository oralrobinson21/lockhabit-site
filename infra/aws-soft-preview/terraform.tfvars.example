# Soft preview only — no secrets, no custom domains.
# Oral21 021067821343 / us-east-1

aws_region             = "us-east-1"
app                    = "lockhabit"
env                    = "preview"
# name_prefix defaults to "lockhabit-preview-web"
image_tag              = "soft"
enable_cloudfront_soft = true

# Non-secret Soft runtime defaults. Put Stripe/Supabase/Resend secrets in
# App Runner console or CI — never commit them here.
soft_runtime_env = {
  NODE_ENV    = "production"
  PORT        = "3000"
  STRIPE_MODE = "test"
}
