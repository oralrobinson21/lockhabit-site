# Supabase browser configuration
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase server configuration
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe mode and browser-side publishable keys. Vite embeds the selected key at build time.
STRIPE_MODE=test
VITE_STRIPE_MODE=test
VITE_PAYMENTS_CLIENT_TOKEN=
VITE_PAYMENTS_CLIENT_TOKEN_LIVE=

# Preferred direct server-side Stripe credentials (use a restricted key where possible)
STRIPE_RESTRICTED_KEY_TEST=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_RESTRICTED_KEY_LIVE=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# Optional Lovable Stripe connector fallback
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
LOVABLE_API_KEY=

# Resend order confirmations
RESEND_API_KEY=
LOCKHABIT_ORDER_FROM_EMAIL=
LOCKHABIT_SUPPORT_EMAIL=
